# ==============================
# AWS
# ==============================
AWS_REGION=us-east-1
AWS_PROFILE=default
AWS_ENDPOINT_URL=http://localhost:4566

# ==============================
# Bedrock
# ==============================
# Verified by CLI on 2026-09-04 (aws bedrock-runtime converse).
# Claude Sonnet 5 is NOT invocable from our accounts: both us.anthropic.claude-sonnet-5
# and global.anthropic.claude-sonnet-5 return AccessDeniedException, even though the
# profile shows as ACTIVE in list-inference-profiles. Claude Sonnet 4 is retired
# ("marked by provider as Legacy"). Do not switch to either without re-running the
# converse check. Verified alternates, swappable via this variable alone:
# us.anthropic.claude-sonnet-4-6, us.anthropic.claude-opus-4-5-20251101-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Cheaper model for high-volume, low-reasoning sub-agent steps. See docs/contracts.md 4.4.
BEDROCK_MODEL_ID_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1

# ==============================
# DynamoDB
# ==============================
DYNAMODB_ENDPOINT=http://localhost:4566
DYNAMODB_TABLE_CASES=chargeguard-cases
DYNAMODB_TABLE_TRANSACTIONS=chargeguard-transactions
DYNAMODB_TABLE_DECISIONS=chargeguard-decisions

# ==============================
# S3
# ==============================
S3_ENDPOINT=http://localhost:4566
S3_BUCKET_EVIDENCE=chargeguard-evidence

# ==============================
# Mock services (local development)
# ==============================
MOCK_BANK_URL=http://localhost:8001
MOCK_MERCHANT_URL=http://localhost:8002
# Resolved from inside the mock-bank container, where localhost is the container
# itself, not the backend. "backend" is the compose service name. Override with
# http://localhost:8000/... only when running the services directly on the host.
BACKEND_WEBHOOK_URL=http://backend:8000/transactions/webhook
DATASET_DIR=./datasets
DEMO_USER_ID=usr_demo

# ==============================
# Backend
# ==============================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO

# ==============================
# Frontend
# ==============================
VITE_API_URL=http://localhost:8000
