# ==============================
# AWS
# ==============================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# ==============================
# Bedrock
# ==============================
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
BEDROCK_REGION=us-east-1

# ==============================
# DynamoDB
# ==============================
DYNAMODB_ENDPOINT=http://localhost:4566
DYNAMODB_TABLE_CASES=chargeguard-cases
DYNAMODB_TABLE_TRANSACTIONS=chargeguard-transactions
DYNAMODB_TABLE_DECISIONS=chargeguard-decisions

# ==============================
# S3
# ==============================
S3_ENDPOINT=http://localhost:4566
S3_BUCKET_EVIDENCE=chargeguard-evidence

# ==============================
# Mock services (local development)
# ==============================
MOCK_BANK_URL=http://localhost:8001
MOCK_MERCHANT_URL=http://localhost:8002

# ==============================
# Backend
# ==============================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO

# ==============================
# Frontend
# ==============================
VITE_API_URL=http://localhost:8000
